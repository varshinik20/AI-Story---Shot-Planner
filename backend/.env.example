# Application Settings
APP_NAME=CINEMIND
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# PostgreSQL (Async SQLAlchemy URL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cinemind_db

# Separate Test PostgreSQL Database URL (used by pytest)
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cinemind_test_db

# CORS Origins (comma-separated or JSON array)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# OpenAI API Configuration
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# MongoDB Authentication Database
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=story_planner_auth
MONGODB_COLLECTION=authorized_credentials

# Single Authorized Account (used to initialize first credential if none exists)
AUTH_USERNAME=
AUTH_PASSWORD=

# JWT & Session Cookie Security
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
